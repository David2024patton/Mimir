# ============================================================
# Mimir - Environment Configuration Example
# ============================================================
# Copy this file to `.env` and fill in your values:
#     cp .env.example .env
#
# NEVER commit your `.env` file - it is gitignored.
# `.env.example` is a safe, secret-free template that IS committed.
# Values below are defaults/examples only.

# ------------------------------------------------------------
# Core / Daemon
# ------------------------------------------------------------
# Where Mimir stores its data (SurrealDB, sessions, the Cortex).
# Default: ~/.mimir
#MIMIR_HOME=

# Port the daemon + GUI listen on. Default: 8420
#MIMIR_PORT=8420

# Log level: debug | info | warn | error. Default: info
#MIMIR_LOG_LEVEL=info

# ------------------------------------------------------------
# Encryption (REQUIRED)
# ------------------------------------------------------------
# Encrypts your provider API keys at rest in SurrealDB.
# Generate one with:  openssl rand -hex 32
MIMIR_ENCRYPTION_KEY=change-me-to-a-random-secret

# ------------------------------------------------------------
# SurrealDB (the Cortex / brain store)
# ------------------------------------------------------------
# Connection to the SurrealDB companion service.
SURREAL_URL=ws://localhost:8000/rpc
SURREAL_USER=root
SURREAL_PASSWORD=root
SURREAL_NAMESPACE=mimir
SURREAL_DATABASE=mimir

# ------------------------------------------------------------
# Provider API keys (BYOK)
# ------------------------------------------------------------
# Referenced via {env:VAR} interpolation in mimir.json.
# Add only the providers you use. Alternatively, store keys via
# `mimir auth login` (saved encrypted to auth.json) instead of env.
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#GOOGLE_GENERATIVE_AI_API_KEY=
#OPENROUTER_API_KEY=
#XAI_API_KEY=
#MISTRAL_API_KEY=
#GROQ_API_KEY=
#DASHSCOPE_API_KEY=
#DEEPSEEK_API_KEY=

# Local models (Ollama / llama.cpp / vLLM) need no key, just the URL:
#OLLAMA_BASE_URL=http://localhost:11434

# ------------------------------------------------------------
# Sandbox (on-the-fly isolation)
# ------------------------------------------------------------
#DOCKER_HOST=

# ------------------------------------------------------------
# Remote access / tunnel (mobile + off-machine) - configured later
# ------------------------------------------------------------
#MIMIR_RELAY_URL=
#MIMIR_TUNNEL_TOKEN=

# ------------------------------------------------------------
# Telemetry
# ------------------------------------------------------------
# Anonymous usage telemetry. Default: off (local-first, privacy-first).
#MIMIR_TELEMETRY=false
